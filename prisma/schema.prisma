generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Expense {
  id        String   @id @default(cuid())
  amount    Float
  category  String   @default("Other")
  note      String   @default("")
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Budget {
  id        String   @id @default(cuid())
  month     String   @unique
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
